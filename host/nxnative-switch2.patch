+// Switch 2's newer NVN entry points build a program in two steps. Keep the builder's
+// device and shader list out of the guest object's opaque storage, then hand it to
+// the same program path used by the older SetShaders API.
+typedef struct prog_builder_state {
+    void *key;
+    NVNdevice *device;
+    int n;
+    NVNshaderData shaders[6];
+    struct prog_builder_state *next;
+} prog_builder_state;
+static pthread_mutex_t g_pb_mu = PTHREAD_MUTEX_INITIALIZER;
+static prog_builder_state *g_pb;
+static prog_builder_state *pb_get(void *key, int create) {
+    pthread_mutex_lock(&g_pb_mu);
+    prog_builder_state *p = g_pb;
+    while (p && p->key != key) p = p->next;
+    if (!p && create) {
+        p = calloc(1, sizeof *p);
+        if (p) { p->key = key; p->next = g_pb; g_pb = p; }
+    }
+    pthread_mutex_unlock(&g_pb_mu);
+    return p;
+}
+NVN_NOPROTO(nvnProgramBuilderSetDefaults, void, void *b, NVNdevice *d) {
+    prog_builder_state *p = pb_get(b, 1); if (!p) return;
+    pthread_mutex_lock(&g_pb_mu); p->device = d; p->n = 0; memset(p->shaders, 0, sizeof p->shaders); pthread_mutex_unlock(&g_pb_mu);
+}
+NVN_NOPROTO(nvnProgramBuilderSetDevice, void, void *b, NVNdevice *d) {
+    prog_builder_state *p = pb_get(b, 1); if (!p) return;
+    pthread_mutex_lock(&g_pb_mu); p->device = d; pthread_mutex_unlock(&g_pb_mu);
+}
+NVN_NOPROTO(nvnProgramBuilderSetShaders, void, void *b, int n, const NVNshaderData *sd) {
+    prog_builder_state *p = pb_get(b, 1); if (!p) return;
+    if (n < 0 || n > 6 || (n && !sd)) { LOG("[RED] ProgramBuilderSetShaders invalid stage count %d", n); n = 0; }
+    pthread_mutex_lock(&g_pb_mu); p->n = n; if (n) memcpy(p->shaders, sd, (size_t)n * sizeof *sd); pthread_mutex_unlock(&g_pb_mu);
+}
+NVN_NOPROTO(nvnProgramInitializeFromBuilder, NVNboolean, NVNprogram *out, const void *b) {
+    NVNdevice *device = NULL; int n = 0; NVNshaderData shaders[6] = {{0}};
+    prog_builder_state *p = pb_get((void *)b, 0);
+    if (p) { pthread_mutex_lock(&g_pb_mu); device = p->device; n = p->n; memcpy(shaders, p->shaders, sizeof shaders); pthread_mutex_unlock(&g_pb_mu); }
+    if (!p || !n) { LOG("[RED] ProgramInitializeFromBuilder has no shaders (%p)", b); return 0; }
+    if (!h_nvnProgramInitialize(out, device)) return 0;
+    return h_nvnProgramSetShaders(out, n, shaders);
+}
